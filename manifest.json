{
    "name": "AlgoGate",
    "description": "Productivity browser extension that blocks social media access until you complete a LeetCode problem.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}
