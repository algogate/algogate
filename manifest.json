{
    "name": "AlgoGate",
    "description": "Productivity browser extension that blocks social media access until you complete a LeetCode problem.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://leetcode.com/*",
                "*://www.leetcode.com/*"
            ],
            "js": ["detect-solved.js"],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "/pages/popup/popup.html",
        "default_title": "AlgoGate"
    },
    "externally_connectable": {
       "matches": ["chrome-extension://nfpgjkacnomfnenmgdghljglpiefneho/pages/blocked/blocked.html"]
    }
}
